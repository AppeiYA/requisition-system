# Requisition System – environment configuration
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Variables marked REQUIRED must be set or the app refuses to start.
# Everything else falls back to the default shown here.

# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
# "development", "staging" or "production"
APP_ENV=development

# Analytics query source: "direct" (default) or "materialized".
ANALYTICS_SOURCE=direct

# Base path the API is served under.
API_BASE_URL=/api/v1

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
# Listen address, including the leading colon for "all interfaces".
SERVER_PORT=:8080
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=120s

# ─────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────
# REQUIRED
DB_HOST=localhost
# REQUIRED
DB_USER=postgres
# REQUIRED
DB_PASSWORD=postgres
# REQUIRED
DB_NAME=requisition_system

DB_PORT=5432
DB_SSL_MODE=disable
# Use verify-full in staging/production and provide the CA bundle path.
DB_CA_CERT=
DB_MAX_OPEN_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=10
DB_MAX_LIFETIME_MINUTES=30

# ─────────────────────────────────────────────────────────────
# Redis (refresh-token sessions and asynq task queues)
# ─────────────────────────────────────────────────────────────
# REQUIRED
REDIS_HOST=localhost
# REQUIRED
REDIS_PORT=6379

REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
# Required for a private Redis CA; the host CA pool is used when empty.
REDIS_CA_CERT=
# Defaults to REDIS_HOST; set this when the certificate name differs.
REDIS_TLS_SERVER_NAME=

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────
# REQUIRED – at least 32 characters. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

JWT_ISSUER=requisition-system
JWT_AUDIENCE=requisition-system
JWT_ACCESS_TOKEN_TTL=15m
# Must be greater than JWT_ACCESS_TOKEN_TTL. 168h = 7 days.
JWT_REFRESH_TOKEN_TTL=168h
JWT_LEEWAY=30s

# ─────────────────────────────────────────────────────────────
# Password reset (self-service)
# ─────────────────────────────────────────────────────────────
# Set to false to hide the forgot/reset routes until the frontend
# reset page is deployed. Defaults to true.
PASSWORD_RESET_ENABLED=true

# How long a reset link stays valid. Must be positive.
PASSWORD_RESET_TOKEN_TTL=30m

# Minimum gap between two reset emails for the same account.
PASSWORD_RESET_REQUEST_COOLDOWN=1m

# Maximum reset requests per account in a rolling hour.
PASSWORD_RESET_MAX_PER_HOUR=5

# How long spent token rows are kept before the hourly cleanup deletes them.
# Must be at least PASSWORD_RESET_TOKEN_TTL.
PASSWORD_RESET_CLEANUP_RETENTION=168h

# ─────────────────────────────────────────────────────────────
# Attachments (file storage)
# ─────────────────────────────────────────────────────────────
# Storage driver: "local" (disk) or "s3" (S3-compatible object store).
ATTACHMENT_STORAGE_DRIVER=local

# Disk root for the local driver. Mount a volume here in production; this
# directory is not part of the container image and is not included in DB
# backups. Created with mode 0700 on first use.
ATTACHMENT_LOCAL_ROOT=./var/attachments

# Per-file cap in bytes (10 MiB) and maximum attachments per parent.
ATTACHMENT_MAX_SIZE_BYTES=10485760
ATTACHMENT_MAX_PER_REF=10

# Lifetime of a signed download URL. Only used by drivers that can sign.
ATTACHMENT_SIGNED_URL_TTL=5m

# How long a file staged before requisition creation remains claimable.
# Expired uploads are rejected at claim time and collected by cleanup.
# ATTACHMENT_STAGING_TTL is accepted as a legacy alias.
STAGED_UPLOAD_TTL=24h

# Per-user pending staged-upload quotas. Bytes=0 disables the byte cap.
STAGED_UPLOAD_MAX_PENDING_PER_USER=20
STAGED_UPLOAD_MAX_BYTES_PER_USER=0

# Outbox reconciliation: each sweep moves at most BATCH_SIZE due files,
# retrying with exponential BACKOFF up to MAX_ATTEMPTS. SCHEDULE is an asynq
# cronspec; the default runs every 15 seconds. STUCK_AFTER is how long an
# attachment may remain PROCESSING before cleanup requeues its event.
ATTACHMENT_RECONCILE_BATCH_SIZE=50
ATTACHMENT_RECONCILE_MAX_ATTEMPTS=5
ATTACHMENT_RECONCILE_BACKOFF=1m
ATTACHMENT_RECONCILE_SCHEDULE=@every 15s
ATTACHMENT_RECONCILE_STUCK_AFTER=15m
ATTACHMENT_CLEANUP_SCHEDULE=@every 5m

# S3 driver settings. BUCKET is required when the driver is "s3". REGION is
# required unless a custom ENDPOINT is set (MinIO defaults to us-east-1).
# Credentials must be both set or both empty; prefer a task role in production.
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_REGION=
# Custom endpoint for MinIO/R2, e.g. http://localhost:9000
ATTACHMENT_S3_ENDPOINT=
ATTACHMENT_S3_ACCESS_KEY_ID=
ATTACHMENT_S3_SECRET_ACCESS_KEY=
ATTACHMENT_S3_FORCE_PATH_STYLE=false
ATTACHMENT_S3_USE_SSL=true

# ─────────────────────────────────────────────────────────────
# Rate limiting (per client IP, backed by Redis)
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15m
RATE_LIMIT_REFRESH_MAX=10
RATE_LIMIT_REFRESH_WINDOW=1m
RATE_LIMIT_LOGOUT_MAX=20
RATE_LIMIT_LOGOUT_WINDOW=1m

# Forgot password is generic: throttled requests still look successful.
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_WINDOW=15m
RATE_LIMIT_RESET_PASSWORD_MAX=10
RATE_LIMIT_RESET_PASSWORD_WINDOW=15m

# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For.
RATE_LIMIT_TRUSTED_PROXIES=

# ─────────────────────────────────────────────────────────────
# Email – delivered through Resend (https://resend.com)
# ─────────────────────────────────────────────────────────────
# REQUIRED – create a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Must be a verified sender in Resend; the sandbox
# address "onboarding@resend.dev" works out of the box for testing.
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Requisition System

# ─────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────
# Base URL used to build the invitation and password-reset links inside emails.
FRONTEND_BASE_URL=http://localhost:3000

# Path (relative to FRONTEND_BASE_URL) of the reset-password page.
# Must start with "/"; the raw token is appended as a ?token= query parameter.
FRONTEND_PASSWORD_RESET_PATH=/reset-password

# ─────────────────────────────────────────────────────────────
# Worker – background tasks (go run ./cmd/worker)
# ─────────────────────────────────────────────────────────────
# Parallel task handlers.
WORKER_CONCURRENCY=10

# Queue the worker drains; enqueued tasks go to the same queue.
WORKER_QUEUE=default

# Delivery attempts per task before it is given up on.
WORKER_TASK_MAX_RETRY=5

# Per-attempt processing timeout.
WORKER_TASK_TIMEOUT=30s

# Grace period for in-flight tasks on shutdown.
WORKER_SHUTDOWN_TIMEOUT=8s

# ─────────────────────────────────────────────────────────────
# Observability – traces and metrics
# ─────────────────────────────────────────────────────────────
# Where the traces and the metrics go:
#   stdout – print them on the terminal (default, no collector needed)
#   otlp   – ship them to an OpenTelemetry collector
#   none   – drop them
#
# To point this at the bundled stack in deploy/observability/:
#   TELEMETRY_EXPORTER=otlp
#   OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
TELEMETRY_EXPORTER=stdout

# Name the backend knows the process by. Leave empty to use the built-in
# name: "requisition-system" for the API, "requisition-system-worker" for
# the worker.
OTEL_SERVICE_NAME=

# OTLP collector address, without the scheme.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Transport used to reach the collector: "grpc" or "http".
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Send the telemetry without TLS. Set it to false for a remote collector.
OTEL_EXPORTER_OTLP_INSECURE=true

# Which traces are recorded:
#   always_on                – every trace
#   always_off               – no trace
#   parentbased_always_on    – every trace, following the upstream decision
#   parentbased_traceidratio – a ratio of the traces, following the upstream
#                              decision (default)
#   traceidratio             – a ratio of the traces
OTEL_TRACES_SAMPLER=parentbased_traceidratio

# Ratio of the traces to record, between 0 and 1.
OTEL_TRACES_SAMPLER_ARG=1

# How often the metrics are pushed to the collector, counted in milliseconds.
# The OpenTelemetry specification writes this interval in milliseconds and the
# SDK reads the very same variable, so "10000" is ten seconds and a duration
# like "10s" is rejected by both.
#
# The shorter it is, the sooner a panel shows the request that caused it. The
# collector batches what it receives and Prometheus scrapes it every 15s, so
# anything under that buys little outside a local stack.
OTEL_METRIC_EXPORT_INTERVAL=10000

# Extra resource attributes, as "key=value" pairs separated by commas.
# They override the ones the application sets by itself, for example:
#   OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
OTEL_RESOURCE_ATTRIBUTES=

# ─────────────────────────────────────────────────────────────
# Logging – structured logging with OpenTelemetry correlation
# ─────────────────────────────────────────────────────────────
# Log level: "debug", "info", "warn", or "error". Default: info.
LOG_LEVEL=info

# Output format: "text" (human-readable for dev) or "json" (for production/log collectors).
# Default: text in development/test, json in production.
LOG_FORMAT=text

# Whether to include source file and line number in log records (true/false).
LOG_ADD_SOURCE=false
