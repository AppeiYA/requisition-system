# Requisition System – environment configuration
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Variables marked REQUIRED must be set or the app refuses to start.
# Everything else falls back to the default shown here.

# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
# "development", "staging" or "production"
APP_ENV=development

# Base path the API is served under.
API_BASE_URL=/api/v1

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
# Listen address, including the leading colon for "all interfaces".
SERVER_PORT=:8080
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=120s

# ─────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────
# REQUIRED
DB_HOST=localhost
# REQUIRED
DB_USER=postgres
# REQUIRED
DB_PASSWORD=postgres
# REQUIRED
DB_NAME=requisition_system

DB_PORT=5432
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=10
DB_MAX_LIFETIME_MINUTES=30

# ─────────────────────────────────────────────────────────────
# Redis (refresh-token sessions and asynq task queues)
# ─────────────────────────────────────────────────────────────
# REQUIRED
REDIS_HOST=localhost
# REQUIRED
REDIS_PORT=6379

REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────
# REQUIRED – at least 32 characters. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

JWT_ISSUER=requisition-system
JWT_AUDIENCE=requisition-system
JWT_ACCESS_TOKEN_TTL=15m
# Must be greater than JWT_ACCESS_TOKEN_TTL. 168h = 7 days.
JWT_REFRESH_TOKEN_TTL=168h
JWT_LEEWAY=30s

# ─────────────────────────────────────────────────────────────
# Email – delivered through Resend (https://resend.com)
# ─────────────────────────────────────────────────────────────
# REQUIRED – create a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Must be a verified sender in Resend; the sandbox
# address "onboarding@resend.dev" works out of the box for testing.
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Requisition System

# ─────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────
# Base URL used to build the invitation links inside emails.
FRONTEND_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Worker – background tasks (go run ./cmd/worker)
# ─────────────────────────────────────────────────────────────
# Parallel task handlers.
WORKER_CONCURRENCY=10

# Queue the worker drains; enqueued tasks go to the same queue.
WORKER_QUEUE=default

# Delivery attempts per task before it is given up on.
WORKER_TASK_MAX_RETRY=5

# Per-attempt processing timeout.
WORKER_TASK_TIMEOUT=30s

# Grace period for in-flight tasks on shutdown.
WORKER_SHUTDOWN_TIMEOUT=8s

# ─────────────────────────────────────────────────────────────
# Observability – traces and metrics
# ─────────────────────────────────────────────────────────────
# Where the traces and the metrics go:
#   stdout – print them on the terminal (default, no collector needed)
#   otlp   – ship them to an OpenTelemetry collector
#   none   – drop them
#
# To point this at the bundled stack in deploy/observability/:
#   TELEMETRY_EXPORTER=otlp
#   OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
TELEMETRY_EXPORTER=stdout

# Name the backend knows the process by. Leave empty to use the built-in
# name: "requisition-system" for the API, "requisition-system-worker" for
# the worker.
OTEL_SERVICE_NAME=

# OTLP collector address, without the scheme.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Transport used to reach the collector: "grpc" or "http".
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Send the telemetry without TLS. Set it to false for a remote collector.
OTEL_EXPORTER_OTLP_INSECURE=true

# Which traces are recorded:
#   always_on                – every trace
#   always_off               – no trace
#   parentbased_always_on    – every trace, following the upstream decision
#   parentbased_traceidratio – a ratio of the traces, following the upstream
#                              decision (default)
#   traceidratio             – a ratio of the traces
OTEL_TRACES_SAMPLER=parentbased_traceidratio

# Ratio of the traces to record, between 0 and 1.
OTEL_TRACES_SAMPLER_ARG=1

# How often the metrics are pushed to the collector, counted in milliseconds.
# The OpenTelemetry specification writes this interval in milliseconds and the
# SDK reads the very same variable, so "10000" is ten seconds and a duration
# like "10s" is rejected by both.
#
# The shorter it is, the sooner a panel shows the request that caused it. The
# collector batches what it receives and Prometheus scrapes it every 15s, so
# anything under that buys little outside a local stack.
OTEL_METRIC_EXPORT_INTERVAL=10000

# Extra resource attributes, as "key=value" pairs separated by commas.
# They override the ones the application sets by itself, for example:
#   OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
OTEL_RESOURCE_ATTRIBUTES=
