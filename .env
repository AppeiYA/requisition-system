# App Configuration
APP_ENV=development
APP_PORT=8080

# API Configuration
API_BASE_URL=/api/v1

# Server Configuration
SERVER_ADDRESS=:8080
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=120s

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=requisition_db
DB_SSL_MODE=disable
